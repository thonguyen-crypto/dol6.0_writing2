# Đặt ở Environment lúc chạy (Dokploy...). Không dùng tiền tố VITE_ cho bí mật.
TEACHER_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
APP_URL=https://lessonX.dol.vn
# Mã lớp có sẵn khi server chạy lần đầu (cách nhau bằng dấu phẩy)
DEFAULT_CLASS_CODES=DOL-2026,DOL-2027
# Gắn /app/.data làm volume bền vững
DATA_DIR=/app/.data
# Chỉ để demo/local khi chưa có key: chấm AI giả lập (KHÔNG bật trên production)
AI_FAKE=
